{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "license-server",
  "main": "server.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "exclude": [
      "node_modules/**",
      ".git/**",
      "*.db",
      "*.db-*",
      "server.js",
      "wrangler.jsonc"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "license-db",
      "database_id": "ضع-DATABASE-ID-هنا"
    }
  ]
}
