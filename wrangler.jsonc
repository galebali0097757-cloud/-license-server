{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "license-server",
  "main": "server.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v86/*",
      "/v85/*",
      "/v1/*",
      "/health"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "license-db",
      "database_id": "20451793-3f89-4452-8c6f-2908b3356fc8"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "REAPER_PAYLOADS",
      "bucket_name": "reaper-v85-private"
    }
  ]
}
